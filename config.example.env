NEWS_MEMORY_HOME=/path/to/news-memory
NEWS_MEMORY_DB=news_memory
NEWS_MEMORY_DB_USER=news-memory
NEWS_MEMORY_DB_HOST=/run/postgresql
NEWS_MEMORY_DB_PORT=5432
NEWS_MEMORY_EMBED_MODEL=/path/to/news-memory/models/Qwen3-Embedding-0.6B
NEWS_MEMORY_EMBED_URL=http://127.0.0.1:8092
NEWS_MEMORY_EMBED_DEVICE=cpu
NEWS_MEMORY_EMBED_LOCAL=0
NEWS_MEMORY_EXTRACT_URL=http://127.0.0.1:8080
NEWS_MEMORY_LLAMA_URL=http://127.0.0.1:8080
NEWS_MEMORY_LLAMA_SYSCONFIG=/etc/sysconfig/llama-server
NEWS_MEMORY_CHAT_PORT=8081
NEWS_MEMORY_TOOLS_PORT=8091
NEWS_MEMORY_PIVOT_LANG=en
