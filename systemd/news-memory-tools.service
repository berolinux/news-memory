# Template. setup.sh replaces @PREFIX@.
# System service, account from systemd/news-memory.sysusers.
[Unit]
Description=news-memory retrieval tools HTTP API
After=network.target postgresql.service

[Service]
Type=simple
User=news-memory
Group=news-memory
WorkingDirectory=@PREFIX@
EnvironmentFile=-@PREFIX@/config.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=python @PREFIX@/tools_server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=@PREFIX@
ReadWritePaths=-/run/postgresql

[Install]
WantedBy=multi-user.target
